{
  "name": "symtri",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "audit:deps": "npm audit --audit-level=moderate",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test lib/data/*.test.ts lib/ai/*.test.ts lib/email/*.test.ts lib/newsletter/*.test.ts",
    "test:storage": "tsx scripts/check-storage.ts",
    "test:storage:local": "bash scripts/check-storage-local.sh",
    "test:scale:local": "bash scripts/check-growth-scale-local.sh",
    "check:production": "node scripts/check-production.mjs",
    "evaluate:ask": "node scripts/evaluate-ask.mjs",
    "growth:manage": "tsx scripts/manage-growth.ts",
    "enrichment:manage": "tsx scripts/manage-enrichment.ts",
    "digest:build": "tsx --env-file-if-exists=.env.local scripts/build-digest.ts",
    "check:gtm": "node scripts/check-gtm.mjs",
    "check:topic-performance": "tsx scripts/check-topic-performance.ts",
    "digest:publish": "tsx --env-file-if-exists=.env.local scripts/publish-report.ts",
    "digest:buttondown": "tsx --env-file-if-exists=.env.local scripts/draft-buttondown.ts",
    "check:seo": "node scripts/check-seo.mjs",
    "benchmark:record": "node scripts/record-search-observation.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.8.1",
    "@tanstack/react-virtual": "3.14.15",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.113",
    "fast-xml-parser": "^5.11.1",
    "ipaddr.js": "2.5.0",
    "next": "16.3.8",
    "parse5": "^8.0.1",
    "postgres": "^3.4.9",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "three": "^0.186.1",
    "undici": "8.11.2",
    "workflow": "^4.8.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.3.8",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@workflow/core": {
      "nanoid": "^5.1.16",
      "devalue": "5.9.3"
    },
    "@workflow/world-local": {
      "undici": "^7.29.1"
    },
    "@workflow/world-vercel": {
      "undici": "^7.29.1"
    },
    "http-cache-semantics": "4.3.0",
    "source-map-js": "1.2.2",
    "sharp": "0.35.5"
  }
}
